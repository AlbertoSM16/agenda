# Copia este fichero a .env.local y rellénalo con los datos de tu proyecto Supabase
# (Project Settings → API). En Vercel añade las mismas variables en Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Zona horaria usada para calcular "hoy" (Vercel corre en UTC)
NEXT_PUBLIC_TZ=Europe/Madrid
